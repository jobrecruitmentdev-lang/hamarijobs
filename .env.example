# ============================================================================
# GOVERNMENT RECRUITMENT INTELLIGENCE PLATFORM - ENVIRONMENT EXAMPLE
# ============================================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://hamarijobs.com
API_V1_STR=/api/v1
PROJECT_NAME="Government Recruitment Intelligence Platform"

# SECURITY & AUTHENTICATION
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INTERNAL_API_SECRET=change_this_to_a_secure_internal_sync_secret_token

# DATABASE
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DB=job_recruitment_ai

# REDIS & QUEUE
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
QUEUE_DRIVER=redis

# AI / LLM SERVICES
OPENAI_API_KEY=
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o
FALLBACK_LLM_MODEL=gemini-1.5-flash

# OCR & DOCUMENT EXTRACTION
TESSERACT_CMD=tesseract
TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata
OCR_LANGUAGES=eng+hin
PDF_STORAGE_DIR=storage/notifications
TEMP_DOWNLOAD_DIR=storage/temp

# CRAWLER SETTINGS
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) GovernmentRecruitmentBot/2.0"
CRAWL_TIMEOUT_SECONDS=30
MAX_CONCURRENT_CRAWLS=5
RATE_LIMIT_DELAY_SECONDS=2.0

# SEO & INDEXNOW
INDEXNOW_KEY=
INDEXNOW_HOST=hamarijobs.com
SEARCH_ENGINE_AUTO_SUBMIT=true
